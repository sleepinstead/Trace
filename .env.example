# Copy to .env and fill in whichever providers you have. All are optional.

# https://www.virustotal.com/gui/my-apikey
TRACE_VIRUSTOTAL_API_KEY=

# https://developers.google.com/safe-browsing/v4/get-started
TRACE_GOOGLE_SAFE_BROWSING_API_KEY=

# https://auth.abuse.ch/ (one key covers URLhaus)
TRACE_URLHAUS_AUTH_KEY=

# PhishTank app key and the username it was registered under
TRACE_PHISHTANK_APP_KEY=
TRACE_PHISHTANK_USERNAME=trace

# How long threat-feed answers are cached (hours)
TRACE_INTEL_CACHE_TTL_HOURS=6

# Active checks (redirect following, TLS handshake, page fetch)
TRACE_HTTP_TIMEOUT=8
TRACE_MAX_REDIRECTS=10
# Keep false unless you need to scan hosts on your own network; it disables the SSRF guard.
TRACE_ALLOW_PRIVATE_TARGETS=false

# TRACE_DATABASE_PATH=data/trace.sqlite
# TRACE_CORS_ORIGINS=["http://localhost:5173"]